/**
 * NexChat Firestore Security Rules
 *
 * Rules for Firestore data access and manipulation.
 * Deploy with: firebase deploy --only firestore:rules
 */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────

    // Check if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if the authenticated user's UID matches the given UID
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Check if the authenticated user is a member of the room
    function isRoomMember(room) {
      return isSignedIn() && request.auth.uid in room.data.members;
    }

    // Check if the authenticated user is the creator of the room
    function isRoomCreator(room) {
      return isSignedIn() && request.auth.uid == room.data.creatorId;
    }

    // Get the room document for a given room ID
    function getRoom(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    // Validate that a room's data structure is correct on create
    function isValidRoomCreate(roomData) {
      return roomData.keys().hasAll(['name', 'type', 'creatorId', 'members', 'memberCount', 'isActive', 'createdAt', 'lastActivityAt'])
          && roomData.isActive == true
          && roomData.creatorId == request.auth.uid
          && roomData.members is list
          && roomData.memberCount is number
          && roomData.memberCount > 0
          && roomData.name is string
          && roomData.name.size() > 0
          && roomData.name.size() <= 100
          && roomData.type in ['public', 'private', 'direct'];
    }

    // ─────────────────────────────────────────────
    // Rooms Collection
    // ─────────────────────────────────────────────

    match /rooms/{roomId} {

      // READ: Anyone can read public rooms, members can read private rooms
      allow read: if isSignedIn() && (
        resource.data.type == 'public' ||
        isRoomMember(resource) ||
        isRoomCreator(resource)
      );

      // CREATE: Authenticated users can create rooms
      allow create: if isSignedIn()
          && isValidRoomCreate(request.resource.data)
          && request.auth.uid in request.resource.data.members;

      // UPDATE: Members can update certain fields, creators have more control
      allow update: if isSignedIn() && isRoomMember(resource) && (
        // Members can join/leave (members array and memberCount changes)
        isRoomMember(request.resource.data)
      ) && (
        // Only allow specific fields to be updated by members
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'members', 'memberCount', 'lastActivityAt', 'lastMessage',
          'name', 'description', 'avatarUrl', 'isActive', 'deletedAt', 'type'
        ])
      ) && (
        // If name is being updated, it must still be valid
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) ||
         (request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100))
      ) && (
        // Prevent setting isActive to false unless creator
        (request.resource.data.isActive == true || isRoomCreator(resource))
      );

      // DELETE (soft delete): Only room creator can delete
      allow delete: if isSignedIn() && isRoomCreator(resource);

      // ─────────────────────────────────────────
      // Messages Subcollection
      // ─────────────────────────────────────────

      match /messages/{messageId} {

        // READ: Only room members can read messages
        allow read: if isSignedIn() && isRoomMember(getRoom(roomId));

        // CREATE: Room members can send messages
        allow create: if isSignedIn()
            && isRoomMember(getRoom(roomId))
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.roomId == roomId
            && request.resource.data.keys().hasAll(['roomId', 'senderId', 'senderName', 'type', 'content', 'seenBy', 'createdAt'])
            && request.resource.data.type in ['text', 'system', 'image', 'voice']
            && request.resource.data.content is string
            && request.resource.data.content.size() <= 5000;

        // UPDATE: Only for mark-as-seen (seenBy array) by room members
        allow update: if isSignedIn() && isRoomMember(getRoom(roomId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
            && request.resource.data.seenBy is list
            && request.auth.uid in request.resource.data.seenBy;

        // DELETE: Only the message sender or room creator can delete
        allow delete: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          isRoomCreator(getRoom(roomId))
        );
      }
    }

    // ─────────────────────────────────────────────
    // Users Collection
    // ─────────────────────────────────────────────

    match /users/{userId} {

      // READ: Authenticated users can read other users' basic profiles
      allow read: if isSignedIn();

      // CREATE: Users can only create their own profile
      allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'lastLoginAt'])
          && request.resource.data.uid == userId;

      // UPDATE: Users can only update their own profile
      allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'email', 'emailVerified',
            'lastLoginAt', 'updatedAt', 'status', 'lastSeenAt',
            'bio', 'settings'
          ]);

      // DELETE: Users can delete their own profile
      allow delete: if isOwner(userId);
    }

    // ─────────────────────────────────────────────
    // Deny all other access
    // ─────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
